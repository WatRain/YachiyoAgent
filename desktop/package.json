{
  "name": "yachiyo-agent",
  "productName": "月见八千代",
  "version": "1.0.0",
  "description": "本地的 AI 伙伴：自己填模型服务，密钥只存在你自己的电脑上",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "probe": "electron probe/main.js",
    "backend": "..\\.venv\\Scripts\\python.exe ../packaging/fetch_tiktoken_cache.py && ..\\.venv\\Scripts\\pyinstaller.exe ../packaging/backend.spec --noconfirm --distpath ../packaging/dist --workpath ../packaging/build",
    "predist": "npm run backend",
    "dist": "electron-builder --win",
    "prepack": "npm run backend",
    "pack": "electron-builder --win --dir"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "type": "commonjs",
  "devDependencies": {
    "electron": "^44.4.5",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "com.watrain.yachiyoagent",
    "productName": "月见八千代",
    "directories": {
      "output": "release"
    },
    "files": [
      "main.js",
      "preload.js",
      "backend.js",
      "renderer/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../packaging/dist/yachiyo-backend",
        "to": "backend"
      }
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "artifactName": "YachiyoAgent-Setup-${version}.exe"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "月见八千代",
      "deleteAppDataOnUninstall": false
    }
  }
}
