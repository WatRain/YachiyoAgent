# 开发期自用的端点配置（可选）
#
# 交付版本不使用这个文件 —— 真正的密钥由用户在应用内的设置页填写，
# 存进操作系统凭据管理器（见 core/secrets.py）。
#
# 这个文件只服务于两件事：
#   1. 你跑 tests/ 里的"真调用"测试时提供 key
#   2. 你想绕过 UI、用脚本快速验证 provider 配置
#
# 复制成 .env 后填写（.env 已在 .gitignore 里，不会被提交）：
#   Copy-Item .env.example .env

# 跑 tests/test_persona_regression.py 之类的真调用测试时需要它
YACHIYO_TEST_KEY=

# 可选：把上面留空时用来兜底的 provider 配置
YACHIYO_BASE_URL=https://api.deepseek.com/v1
YACHIYO_MODEL_ID=deepseek-chat
