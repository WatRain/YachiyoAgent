# 虚拟环境
.venv/
venv/
env/

# 机密 —— 最重要的一行
.env
.env.*
!.env.example

# 临时试跑脚本。放这里的东西常常会硬编码 API Key 调试，
# 所以必须忽略，否则 key 会跟着代码上传。
scratch/

# 本地文档：教程、打包清单、agent loop 说明
# 决定不随代码上传（含本地路径与产品思路）。文件仍在本机，随时可读。
docs/

# 用户数据 / 运行时
.devdata/
.flet/
*.db
*.db-wal
*.db-shm

# Python
__pycache__/
*.py[cod]
.pytest_cache/
.pytest_tmp/
.ptmp/
pytest-cache-files-*/
.mypy_cache/
.ruff_cache/

# 打包产物
dist/
build/
*.spec
# 例外：打包规格是源码，要跟着仓库走（PyInstaller 自己生成的 spec 才该忽略）
!packaging/*.spec

# 打包时临时下载的 wheel
wheels/

# tiktoken 的 BPE 词表（构建时由 packaging/fetch_tiktoken_cache.py 下载，约 5MB，不进仓库）
packaging/tiktoken_cache/

# Electron 前端
node_modules/
desktop/.logs/
desktop/release/
